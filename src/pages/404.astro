---
import Base from '../layouts/Base.astro';

const title = 'Page Not Found | Mundesha Investments';
const description = 'The page you are looking for does not exist. Head back to the Mundesha Investments home page.';
---
<Base title={title} description={description} path="/404">
  <section class="error-page">
    <div class="container">
      <p class="code">404</p>
      <h1 style="font-size:1.5rem">This page is not on our site</h1>
      <p>The link may be old or mistyped. The services, projects and contact pages are a click away.</p>
      <div class="hero-ctas" style="justify-content:center;display:flex">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline-dark" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</Base>
