---
import Base from '../layouts/Base.astro';

const title = 'Page Not Found | Mundesha Investments';
const description = 'The page you are looking for does not exist. Head back to the Mundesha Investments home page.';
---
<Base title={title} description={description} path="/404">
  <section class="error-page">
    <div class="container">
      <p class="code" aria-hidden="true">404</p>
      <h1>This page is not on our site</h1>
      <p>The link may be old or mistyped. Try one of these instead, or call us on +264 81 277 7553 and we will point you in the right direction.</p>
      <div class="error-links">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline-dark" href="/contact">Contact us</a>
      </div>
      <ul class="quick">
        <li><a href="/services">Services</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/about">About us</a></li>
      </ul>
    </div>
  </section>
</Base>
