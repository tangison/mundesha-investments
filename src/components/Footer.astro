---
import { SITE, STUDIO_CREDIT } from '../data/site';
import { SERVICES } from '../data/services';

const year = new Date().getFullYear();
const companyLinks = [
  { href: '/company-profile', label: 'Company profile (PDF)' },
  { href: '/projects', label: 'Projects' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/team', label: 'Team' },
  { href: '/clients', label: 'Clients' },
  { href: '/about', label: 'About us' },
  { href: '/brand', label: 'Brand guidelines' },
  { href: '/privacy-policy', label: 'Privacy policy' },
  { href: '/terms', label: 'Terms of service' },
  { href: SITE.instagram.url, label: `Instagram: ${SITE.instagram.handle}`, external: true }
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <img
        src="/logos/mundesha/mundesha-logo-horizontal-dark.svg"
        alt="Mundesha Investments"
        width="238"
        height="75"
        loading="lazy"
        style="height:64px;width:auto"
      />
      <p class="footer-tagline">Your needs, <span>Our Business</span></p>
      <div class="footer-quick">
        <a href={`tel:${SITE.phones[0].tel}`}>{SITE.phones[0].display}</a>
        <a href={SITE.whatsapp} rel="noopener">WhatsApp</a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </div>
    </div>

    <div class="footer-drop">
      <details>
        <summary>Services</summary>
        <ul>
          {SERVICES.map((s) => (
            <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
          ))}
        </ul>
      </details>
      <details>
        <summary>Company</summary>
        <ul>
          {companyLinks.map((l) => (
            <li><a href={l.href} {...('external' in l ? { rel: 'noopener' } : {})}>{l.label}</a></li>
          ))}
        </ul>
      </details>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {SITE.legalName}. {SITE.address}.</span>
      <span class="credit">Made by <a href={STUDIO_CREDIT.url} rel="noopener">Tangison Studio</a></span>
    </div>
  </div>
</footer>
