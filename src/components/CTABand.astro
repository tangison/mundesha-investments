---
import { SITE } from '../data/site';
---
<section class="cta-band">
  <div class="container">
    <h2>Tell us what you need</h2>
    <p>
      Air conditioning, refrigeration, electrical work and more, delivered anywhere in Namibia.
      Request a quote and we will come back to you.
    </p>
    <div class="btn-row">
      <a class="btn btn-white" href="/contact">Request a quote</a>
      <a class="btn btn-outline-light" href={SITE.whatsapp} rel="noopener">WhatsApp us</a>
    </div>
  </div>
</section>
