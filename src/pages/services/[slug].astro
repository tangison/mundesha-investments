---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import { SERVICES, SERVICE_ACCENTS, SERVICE_BY_SLUG, type ServiceDef } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { SITE } from '../../data/site';
import images from '../../data/images.json';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceDef;
}

const { service } = Astro.props;

const PHOTO_ALT: Record<string, string> = {
  'split-ac-installed-clinic': 'Split air conditioning unit installed on a clinic wall',
  'samsung-split-units-install': 'Technician installing split air conditioning units',
  'ac-office-install': 'Technician drilling a split air conditioner bracket in an office',
  'ac-manifold-service': 'Technician checking condenser pressures with manifold gauges',
  'ac-rural-condensers': 'Air conditioner condenser units mounted on a building wall',
  'freezer-room-condensing-unit': 'Condensing unit on an industrial freezer room',
  'reefer-unit-service': 'Technician servicing a reefer unit',
  'condenser-gauges': 'Technician servicing a condenser unit with manifold gauges',
  'display-fridge-service': 'Technician servicing a glass door display fridge',
  'distribution-board': 'Distribution board wiring during installation',
  'electrician-wiring-panel': 'Electrician wiring an electrical panel',
  'db-wiring': 'Electrician wiring a distribution board',
  'cable-trench': 'Team laying underground cable in a trench',
  'multimeter-test': 'Electrician testing a distribution board with a multimeter',
  'solar-gate': 'Solar powered gate installation',
  'construction-site': 'Construction site with brickwork under way',
  'water-tank-stand': 'Completed steel water tank stand',
  'bricklaying': 'Bricklayers building a wall on site',
  'floor-tiling': 'Tiler laying floor tiles',
  'office-mopping': 'Cleaner mopping an office floor',
  'cleaning-team': 'Cleaning team with a loaded service trolley',
  'floor-scrubber': 'Operator using a ride-on floor scrubber in a lobby',
  'commercial-kitchen': 'Stainless steel commercial kitchen',
  'delivery-truck': 'Delivery truck on a rural road',
  'warehouse-packing': 'Team packing boxes on a pallet in a warehouse',
  'forklift-pallet': 'Forklift moving a wrapped pallet',
  'industrial-washer-service': 'Technician servicing an industrial laundry machine',
  'washer-repair-wide': 'Industrial washing machine opened for repair',
  'washer-repair-tall': 'Technician repairing an industrial washer',
  'washer-service-technician-vest': 'Technician in a Mundesha hi-vis vest servicing an industrial washing machine',
  'washer-electrical-repair': 'Technician repairing the wiring of an industrial washing machine',
  'industrial-washers-service-tools': 'Industrial washing machines with service tools laid out on the floor'
};

/** Photos taken on real Mundesha sites. Everything else is illustrative art. */
const REAL_PHOTOS = new Set([
  'split-ac-installed-clinic',
  'samsung-split-units-install',
  'freezer-room-condensing-unit',
  'reefer-unit-service',
  'distribution-board',
  'electrician-wiring-panel',
  'solar-gate',
  'construction-site',
  'water-tank-stand',
  'industrial-washer-service',
  'washer-repair-wide',
  'washer-repair-tall',
  'washer-service-technician-vest',
  'washer-electrical-repair',
  'industrial-washers-service-tools'
]);

const accentMeta = SERVICE_ACCENTS[service.slug];
const accent = accentMeta
  ? (images.accents as Record<string, Record<string, { src: string; width: number; height: number }>>)[accentMeta.cat]?.[accentMeta.file]
  : null;

const photoRepo = images.photos as Record<string, { src: string; width: number; height: number }>;
const photos = service.photos.map((key) => ({ ...photoRepo[key], key })).filter((p) => p.src);
const related = PROJECTS.filter((x) => x.service === service.slug).slice(0, 4);
const serviceName = SERVICE_BY_SLUG.get(service.slug)?.shortName ?? service.name;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.serviceType,
  description: service.metaDescription,
  url: new URL(`/services/${service.slug}`, import.meta.env.SITE).href,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.legalName,
    telephone: SITE.phones[0].tel,
    email: SITE.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Windhoek', addressCountry: 'NA' },
    areaServed: { '@type': 'Country', name: 'Namibia' }
  },
  areaServed: { '@type': 'Country', name: 'Namibia' }
};
---
<Base title={service.metaTitle} description={service.metaDescription} path={`/services/${service.slug}`} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <h1>{service.name.toUpperCase()}</h1>
      <p class="lead">{service.blurb} Delivered across Namibia from our Windhoek base.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="display:grid;gap:44px;grid-template-columns:1fr" class="svc-grid">
        <div>
          <SectionHeading first="THE" second="SERVICE" />
          <div class="prose">
            {service.intro.map((para) => <p>{para}</p>)}
          </div>
          <h3 style="font-size:1.15rem;margin:26px 0 16px">What we cover</h3>
          <ul class="points">
            {service.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
        <div style="display:grid;gap:16px;align-content:start">
          {photos.slice(0, 3).map((ph, i) => (
            <figure class="svc-art" style="margin:0">
              <img
                src={ph.src}
                alt={PHOTO_ALT[ph.key] ?? `${serviceName} work by Mundesha Investments`}
                width={ph.width}
                height={ph.height}
                loading="lazy"
                decoding="async"
                style={i > 0 ? 'max-height:240px' : ''}
              />
              {REAL_PHOTOS.has(ph.key) && (
                <figcaption style="font-size:0.78rem;color:var(--muted);padding:10px 14px;background:#fff">
                  Real site photo: {serviceName.toLowerCase()} by our team.
                </figcaption>
              )}
            </figure>
          ))}
          {photos.length === 0 && accent && (
            <div class="svc-art" style="position:relative">
              <img
                src={accent.src}
                alt=""
                aria-hidden="true"
                width={accent.width}
                height={accent.height}
                loading="lazy"
                decoding="async"
              />
              <p style="position:absolute;inset:auto 0 0;padding:18px;background:linear-gradient(0deg,rgba(2,2,2,.88),transparent);color:#fff;font-weight:600">
                Tell us what you need. We come to you.
              </p>
            </div>
          )}
          <div class="contact-card">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
            </span>
            <div>
              <h3>Call us directly</h3>
              <a href={`tel:${SITE.phones[0].tel}`}>{SITE.phones[0].display}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <SectionHeading first="RECENT" second="WORK" />
        <p class="section-intro">A sample of {service.name.toLowerCase()} jobs from our project record. References available on request.</p>
        <div class="feat-grid">
          {related.map((pr) => (
            <ProjectCard
              client={pr.client}
              work={pr.work}
              date={pr.date}
              year={pr.year}
              service={pr.service}
              serviceName={SERVICE_BY_SLUG.get(pr.service)?.shortName ?? pr.service}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABand />
</Base>

<style>
  @media (min-width: 900px) {
    .svc-grid { grid-template-columns: 1.15fr 0.85fr !important; }
  }
</style>
