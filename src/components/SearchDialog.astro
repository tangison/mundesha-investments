---
---
<div class="search-overlay" id="site-search" role="dialog" aria-modal="true" aria-label="Search the site" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel">
    <div class="search-row">
      <svg class="search-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input
        class="search-input"
        type="search"
        placeholder="Search services, projects and pages"
        aria-label="Search services, projects and pages"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="search-esc" type="button" data-search-close aria-label="Close search">Esc</button>
    </div>
    <p class="search-status" role="status" data-search-status></p>
    <ul class="search-results" data-search-results></ul>
    <p class="search-hint" data-search-hint hidden>No matches. Try a service name such as air conditioning or refrigeration.</p>
  </div>
</div>

<script>
  const overlay = document.getElementById('site-search');
  const input = overlay?.querySelector<HTMLInputElement>('.search-input');
  const resultsEl = overlay?.querySelector<HTMLUListElement>('[data-search-results]');
  const statusEl = overlay?.querySelector<HTMLElement>('[data-search-status]');
  const hintEl = overlay?.querySelector<HTMLElement>('[data-search-hint]');

  type Entry = { t: string; d: string; u: string; k?: string };
  let index: Entry[] | null = null;
  let picks: Entry[] = [];
  let selected = -1;
  let lastTrigger: HTMLElement | null = null;

  function highlight(text: string, q: string) {
    const i = text.toLowerCase().indexOf(q);
    if (i < 0) return text;
    return (
      text.slice(0, i) +
      '<mark>' + text.slice(i, i + q.length) + '</mark>' +
      text.slice(i + q.length)
    );
  }

  function render(q: string) {
    if (!overlay || !resultsEl || !statusEl || !hintEl) return;
    resultsEl.innerHTML = '';
    selected = -1;
    const query = q.trim().toLowerCase();
    if (!query) {
      statusEl.textContent = index ? `${index.length} pages indexed. Type to search.` : 'Loading search index...';
      hintEl.hidden = true;
      return;
    }
    const tokens = query.split(/\s+/);
    const scored: { e: Entry; s: number }[] = [];
    for (const e of index ?? []) {
      const title = e.t.toLowerCase();
      const desc = e.d.toLowerCase();
      const keys = (e.k ?? '').toLowerCase();
      let score = 0;
      let ok = true;
      for (const tok of tokens) {
        if (title.startsWith(tok)) score += 8;
        else if (title.includes(tok)) score += 5;
        else if (keys.includes(tok)) score += 3;
        else if (desc.includes(tok)) score += 2;
        else { ok = false; break; }
      }
      if (ok) scored.push({ e, s: score });
    }
    scored.sort((a, b) => b.s - a.s);
    picks = scored.slice(0, 8).map((x) => x.e);
    if (picks.length === 0) {
      statusEl.textContent = '';
      hintEl.hidden = false;
      return;
    }
    hintEl.hidden = true;
    statusEl.textContent = `${scored.length} result${scored.length === 1 ? '' : 's'}. Enter opens the first, arrows move.`;
    for (const e of picks) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = e.u;
      a.innerHTML = `<span class="sr-title">${highlight(e.t, query)}</span><span class="sr-desc">${e.d}</span>`;
      li.appendChild(a);
      resultsEl.appendChild(li);
    }
  }

  function move(delta: number) {
    if (!resultsEl || picks.length === 0) return;
    const items = [...resultsEl.querySelectorAll('a')];
    selected = (selected + delta + picks.length) % picks.length;
    items.forEach((a, i) => a.classList.toggle('is-active', i === selected));
    items[selected].focus();
  }

  function openSearch(trigger?: HTMLElement) {
    if (!overlay || !input) return;
    lastTrigger = trigger ?? (document.activeElement as HTMLElement | null);
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    if (!index) {
      fetch('/search-index.json')
        .then((r) => r.json())
        .then((data: Entry[]) => { index = data; render(input.value); input.focus(); })
        .catch(() => {
          if (statusEl) statusEl.textContent = 'Search index failed to load.';
          input.focus();
        });
    } else {
      render('');
    }
    input.focus();
  }

  function closeSearch(returnFocus = true) {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
    if (returnFocus && lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
  }

  for (const el of document.querySelectorAll('[data-search-open]')) {
    el.addEventListener('click', () => openSearch(el as HTMLElement));
  }
  for (const el of document.querySelectorAll('[data-search-close]')) {
    el.addEventListener('click', () => closeSearch());
  }

  document.addEventListener('keydown', (e) => {
    if (!overlay || overlay.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); closeSearch(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
  });

  // Keyboard "/" shortcut opens search from anywhere.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || !overlay || !overlay.hidden) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select')) return;
    e.preventDefault();
    openSearch();
  });

  // Keep Tab focus inside the open search dialog.
  overlay?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !overlay || overlay.hidden) return;
    const focusables = overlay.querySelectorAll<HTMLElement>('a[href], input, button:not([disabled])');
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  input?.addEventListener('input', () => render(input.value));
  overlay?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (a) closeSearch(false);
  });
</script>
