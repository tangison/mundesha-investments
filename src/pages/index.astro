---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogoWall from '../components/LogoWall.astro';
import CTABand from '../components/CTABand.astro';
import { SERVICES, SERVICE_BY_SLUG } from '../data/services';
import { FEATURED } from '../data/projects';
import { SITE, REGIONS } from '../data/site';
import { GALLERY } from '../data/gallery';
import images from '../data/images.json';

const hero = images.hero;
const showLogos = process.env.SHOW_CLIENT_LOGOS !== 'false';
const tiles = images.tiles as Record<string, { src: string; width: number; height: number }>;
const stripIds = [
  'split-ac-installation-ladder',
  'water-tank-stand-two-tanks-golden-hour',
  'washer-service-technician-vest',
  'steel-tower-fabrication-sunset',
  'team-workwear-smiling',
  'white-prefab-building-new-pipework'
];
const strip = stripIds.map((id) => GALLERY.find((g) => g.id === id)!);

const title = 'Trade Services Across Namibia | Mundesha Investments';
const description =
  'Technical, construction and support services for government, mining, retail and hospitality across Namibia since 2016. Request a quote.';
---
<Base title={title} description={description} path="/">
  <section class="hero">
    <img
      class="hero-img"
      src={hero.src}
      alt="Technician on a ladder servicing wall mounted air conditioning units"
      width={hero.width}
      height={hero.height}
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-slash s1" aria-hidden="true"></div>
    <div class="hero-slash s2" aria-hidden="true"></div>
    <div class="hero-slash s3" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-content">
        <p class="hero-kicker">Since {SITE.founded} | {SITE.address}</p>
        <h1>
          Technical, construction and support services across <span class="accent">Namibia</span>
        </h1>
        <p class="hero-sub">
          Mundesha Investments has served government, mining, retail and hospitality clients since 2016.
          Quality work at a fair price.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/contact">Request a quote</a>
          <a class="btn btn-outline-light" href={`tel:${SITE.phones[0].tel}`}>Call {SITE.phones[0].display}</a>
        </div>
        <p class="hero-meta">Your needs, Our Business. {SITE.ownerExperience}.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div id="services-heading"><SectionHeading first="OUR" second="SERVICES" /></div>
      <p class="section-intro">
        Eight trade services under one roof. One number to call, one team that shows up.
      </p>
      <div class="tiles">
        {SERVICES.map((s) => (
          <article class="service-card">
            <a href={`/services/${s.slug}`} aria-label={`Learn more about ${s.name}`} style="display:block;color:inherit;text-decoration:none">
              <img
                class="tile-img"
                src={tiles[s.slug]?.src}
                alt=""
                aria-hidden="true"
                width={tiles[s.slug]?.width}
                height={tiles[s.slug]?.height}
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="tile-body">
              <h3>{s.shortName}</h3>
              <p>{s.blurb}</p>
              <a class="more" href={`/services/${s.slug}`} aria-label={`Learn more about ${s.name}`}>Learn more</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-ink proof" aria-label="Track record">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-item">
          <p class="big">{SITE.founded}</p>
          <p class="cap">Founded</p>
        </div>
        <div class="proof-item">
          <p class="big">20+</p>
          <p class="cap">Years of owner experience</p>
          <p>in electrical, air conditioning and refrigeration</p>
        </div>
        <div class="proof-item">
          <p class="big">{REGIONS.length}</p>
          <p class="cap">Regions served</p>
          <p>{REGIONS.join(', ')}</p>
        </div>
        <div class="proof-item">
          <p class="big">2016 to 2025</p>
          <p class="cap">Project record</p>
          <p>including Swakop Uranium, GIPF, Coca-Cola and the Ministry of Justice</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <div id="process-heading"><SectionHeading first="HOW IT" second="WORKS" /></div>
      <p class="section-intro">From your first call to the finished job, four simple steps.</p>
      <ol class="process">
        <li>
          <span class="step" aria-hidden="true">1</span>
          <h3>Tell us what you need</h3>
          <p>Call, WhatsApp or send the form with the job, the town and the date you have in mind.</p>
        </li>
        <li>
          <span class="step" aria-hidden="true">2</span>
          <h3>Site visit</h3>
          <p>For jobs that need it, we visit the site first to see the work with our own eyes, at no charge.</p>
        </li>
        <li>
          <span class="step" aria-hidden="true">3</span>
          <h3>Written quote</h3>
          <p>You receive a written quote with a fixed price and a start date. No surprises later.</p>
        </li>
        <li>
          <span class="step" aria-hidden="true">4</span>
          <h3>We deliver</h3>
          <p>We do the work, we clean up and we hand over. Support continues after the job is done.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="projects-heading">
    <div class="container">
      <div id="projects-heading"><SectionHeading first="RECENT" second="PROJECTS" /></div>
      <p class="section-intro">
        Newest jobs first. The full record lives on the <a class="text-link" href="/projects">projects page</a>.
      </p>
      <div class="feat-grid">
        {FEATURED.map((pr) => (
          <ProjectCard
            client={pr.client}
            work={pr.work}
            date={pr.date}
            year={pr.year}
            service={pr.service}
            serviceName={SERVICE_BY_SLUG.get(pr.service)?.shortName ?? pr.service}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-heading">
    <div class="container">
      <div id="gallery-heading"><SectionHeading first="ON" second="SITE" /></div>
      <p class="section-intro">
        Straight from our jobs around Namibia. See the full set in the <a class="text-link" href="/gallery">gallery</a>.
      </p>
      <div class="gallery-grid">
        {strip.map((g, i) => (
          <a class="gallery-item home-gallery-item" href="/gallery">
            <figure>
              <img
                src={g.file}
                alt={g.alt}
                width={g.width}
                height={g.height}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>{g.caption}</figcaption>
            </figure>
          </a>
        ))}
      </div>
    </div>
  </section>

  {showLogos && (
    <section class="section" aria-labelledby="clients-heading">
      <div class="container">
        <div id="clients-heading"><SectionHeading first="TRUSTED" second="BY" /></div>
        <p class="section-intro">
          Some of the organisations we have worked for. References available on request.
        </p>
        <LogoWall />
      </div>
    </section>
  )}

  <CTABand />
</Base>
