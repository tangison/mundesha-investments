---
import { NAV } from '../data/site';
import { SERVICES } from '../data/services';
import images from '../data/images.json';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
const smallTiles = images.tilesSm as Record<string, { src: string; width: number; height: number }>;
const drawerLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/team', label: 'Team' },
  { href: '/about', label: 'About us' },
  { href: '/clients', label: 'Clients' },
  { href: '/company-profile', label: 'Company profile' },
  { href: '/contact', label: 'Contact' }
];
const topNav = NAV.filter((item) => item.href !== '/services');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label="Mundesha Investments: home">
      <img
        src="/logos/mundesha/mundesha-logo-horizontal-light.svg"
        alt="Mundesha Investments"
        width="238"
        height="75"
      />
    </a>
    <nav class="nav" aria-label="Main">
      <div class="nav-drop" data-nav-drop>
        <button class="nav-drop-btn" type="button" aria-expanded="false" aria-controls="services-menu">
          Services
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav-panel" id="services-menu" aria-label="Services">
          <a href="/services" class="nav-panel-all" aria-current={isActive('/services') ? 'page' : undefined}>
            <span class="nav-panel-name">All services</span>
            <span class="nav-panel-hint">Overview</span>
          </a>
          {SERVICES.map((s) => (
            <a href={`/services/${s.slug}`} aria-current={isActive(`/services/${s.slug}`) ? 'page' : undefined}>
              <span class="nav-panel-name">{s.shortName}</span>
              <span class="nav-panel-hint">{s.serviceType}</span>
            </a>
          ))}
        </div>
      </div>
      {topNav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-primary" href="/contact">Request a quote</a>
    </nav>
    <div class="header-actions">
      <button class="search-btn" type="button" data-search-open aria-haspopup="dialog" aria-label="Search the site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open menu">
        <svg class="icon-bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer-backdrop" data-drawer-close hidden></div>
<nav class="drawer" id="site-drawer" aria-label="Site menu" role="dialog" aria-modal="true" aria-hidden="true" inert>
  <div class="drawer-head">
    <img
      src="/logos/mundesha/mundesha-logo-horizontal-dark.svg"
      alt="Mundesha Investments"
      width="238"
      height="75"
      style="height:34px;width:auto"
    />
    <button class="drawer-close" type="button" data-drawer-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <p class="drawer-label">Services</p>
  <ul class="drawer-services">
    {SERVICES.map((s) => (
      <li>
        <a href={`/services/${s.slug}`}>
          <img
            src={smallTiles[s.slug]?.src}
            alt=""
            aria-hidden="true"
            width="60"
            height="45"
            loading="lazy"
            decoding="async"
          />
          <span>{s.shortName}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="drawer-label">Company</p>
  <ul class="drawer-links">
    {drawerLinks.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>

  <a class="btn btn-primary drawer-cta" href="/contact">Request a quote</a>
</nav>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const drawer = document.getElementById('site-drawer');
  const backdrop = document.querySelector<HTMLElement>('.drawer-backdrop');

  function setDrawer(open: boolean, returnFocus = false) {
    if (!btn || !drawer || !backdrop) return;
    drawer.classList.toggle('open', open);
    drawer.inert = !open;
    backdrop.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      const first = drawer.querySelector<HTMLAnchorElement>('a');
      first?.focus();
    } else if (returnFocus) {
      btn.focus();
    }
  }

  if (btn && drawer && backdrop) {
    btn.addEventListener('click', () => setDrawer(!drawer.classList.contains('open')));
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setDrawer(false);
    });
    for (const el of document.querySelectorAll('[data-drawer-close]')) {
      el.addEventListener('click', () => setDrawer(false, true));
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawer(false, true);
      }
    });
    // Tab focus trap: keyboard stays inside the open drawer.
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !drawer.classList.contains('open')) return;
      const focusables = drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  // Desktop services dropdown: hover intent + click + full keyboard support.
  const drop = document.querySelector<HTMLElement>('[data-nav-drop]');
  const dropBtn = drop?.querySelector<HTMLButtonElement>('.nav-drop-btn');
  const dropPanel = drop?.querySelector<HTMLElement>('.nav-panel');
  let hoverTimer: ReturnType<typeof setTimeout> | undefined;

  function setDrop(open: boolean, returnFocus = false) {
    if (!drop || !dropBtn || !dropPanel) return;
    drop.classList.toggle('open', open);
    dropBtn.setAttribute('aria-expanded', String(open));
    if (!open && returnFocus) dropBtn.focus();
  }

  if (drop && dropBtn && dropPanel) {
    dropBtn.addEventListener('click', (e) => {
      // Mouse users already opened the panel by hovering; a click must not
      // immediately close it again. Touch and keyboard still toggle.
      if ((e as PointerEvent).pointerType === 'mouse') {
        setDrop(true);
        return;
      }
      setDrop(!drop.classList.contains('open'));
    });
    drop.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimer);
      setDrop(true);
    });
    drop.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimer);
      hoverTimer = setTimeout(() => setDrop(false), 140);
    });
    drop.addEventListener('focusout', (e) => {
      if (!drop.contains(e.relatedTarget as Node)) setDrop(false);
    });
    document.addEventListener('click', (e) => {
      if (!drop.contains(e.target as Node)) setDrop(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drop.classList.contains('open')) {
        setDrop(false, true);
      }
    });
  }
</script>
