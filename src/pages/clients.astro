---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LogoWall from '../components/LogoWall.astro';
import CTABand from '../components/CTABand.astro';

const showLogos = process.env.SHOW_CLIENT_LOGOS !== 'false';

const title = 'Our Clients | Mundesha Investments';
const description =
  'Organisations Mundesha Investments has served since 2016, including Swakop Uranium, GIPF, Coca-Cola, MTC, NWR and regional councils across Namibia.';

const moreClients = [
  'Ministry of Health and Social Services',
  'Ministry of Justice',
  'Ministry of Works',
  'NORED',
  'Epako Clinic, Gobabis',
  'Epukiro Clinic',
  'Da Palm Secondary School',
  'Keetmans Pharmacy',
  'Shield Force Consulting Engineers'
];
---
<Base title={title} description={description} path="/clients">
  <section class="page-hero">
    <div class="container">
      <h1>OUR CLIENTS</h1>
      <p class="lead">Government offices, mines, retailers and hospitality groups have trusted us with their facilities since 2016.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading first="WHO WE" second="WORK FOR" />
      {showLogos ? (
        <LogoWall />
      ) : (
        <p class="section-intro">A client list is available on request while logo permissions are being confirmed.</p>
      )}
      <h3 style="font-size:1.15rem;margin:40px 0 14px">And more across the country</h3>
      <ul class="tag-cloud">
        {moreClients.map((c) => <li class="tag">{c}</li>)}
      </ul>

      <div style="margin-top:44px;max-width:70ch">
        <h3 style="font-size:1.15rem;margin-bottom:14px">How our client engagements work</h3>
        <p style="margin-bottom:14px">
          Most clients come to us with a problem: a broken air conditioner, a hall that needs repainting,
          a storeroom that must be stocked. We visit the site, agree on the scope in writing and quote a
          fixed price before any work starts. Once the job is approved, our own workforce carries it out,
          supervised by the owner, the same way we have worked since 2016.
        </p>
        <p style="margin-bottom:14px">
          On mines and government sites we work to the client's rules. Our teams attend safety briefings,
          carry the required protective equipment and fit in with shift schedules, including night work
          where the contract calls for it. Because we deliver air conditioning, refrigeration, electrical,
          construction, cleaning and supply services with one team, clients deal with one contractor
          instead of coordinating several.
        </p>
        <p>
          Client logos and names appear here as a factual record of work delivered. Logos belong to their
          respective organisations, and references from past projects are available on request.
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
