---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTABand from '../../components/CTABand.astro';
import { SERVICES } from '../../data/services';
import images from '../../data/images.json';

const title = 'Our Services | Mundesha Investments';
const description =
  'Eight trade services across Namibia: air conditioning, refrigeration, electrical, cleaning, construction, catering, supply and maintenance. One team, one call.';

const tiles = images.tiles as Record<string, { src: string; width: number; height: number }>;
---
<Base title={title} description={description} path="/services">
  <section class="page-hero">
    <div class="container">
      <h1>OUR SERVICES</h1>
      <p class="lead">Eight trades, one contractor. Every service comes with the same promise: quality of work and good value for money.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading first="WHAT WE" second="DO" />
      <p class="section-intro">
        Every service below is delivered by our own people. Technicians, artisans, welders, electricians,
        cleaners and general workers work under one management structure, so a single phone call covers
        repairs, installations, renovations and the supplies that go with them.
      </p>
      <div class="tiles" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
        {SERVICES.map((s) => {
          const tile = tiles[s.slug];
          return (
            <article class="service-card">
              {tile && (
                <a href={`/services/${s.slug}`} aria-label={`Learn more about ${s.name}`} style="display:block">
                  <img
                    class="tile-img"
                    src={tile.src}
                    alt=""
                    aria-hidden="true"
                    width={tile.width}
                    height={tile.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="tile-body">
                <h3>{s.name}</h3>
                <p>{s.blurb}</p>
                <a class="more" href={`/services/${s.slug}`}>Learn more</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTABand />
</Base>
